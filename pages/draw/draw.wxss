.draw-page {
  min-height: 100vh;
  background: radial-gradient(ellipse at 50% 30%, #1c2029 0%, #12141a 70%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stage {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.mystery {
  transition: transform 0.2s;
}
.mystery:active {
  transform: scale(0.97);
}

/* 开盒抖动 */
@keyframes shake {
  0%,
  100% {
    transform: translateX(0) rotate(0deg);
  }
  10% {
    transform: translateX(-14rpx) rotate(-2deg);
  }
  20% {
    transform: translateX(12rpx) rotate(2deg);
  }
  30% {
    transform: translateX(-16rpx) rotate(-3deg);
  }
  40% {
    transform: translateX(14rpx) rotate(3deg);
  }
  50% {
    transform: translateX(-12rpx) rotate(-2deg);
  }
  60% {
    transform: translateX(12rpx) rotate(2deg);
  }
  70% {
    transform: translateX(-8rpx) rotate(-1deg);
  }
  80% {
    transform: translateX(8rpx) rotate(1deg);
  }
  90% {
    transform: translateX(-4rpx) rotate(0deg);
  }
}
.shaking {
  animation: shake 0.9s ease-in-out;
}

.tip {
  margin-top: 48rpx;
  color: #8a8f99;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

/* 揭晓 */
@keyframes flipIn {
  0% {
    opacity: 0;
    transform: rotateY(90deg) scale(0.8);
  }
  100% {
    opacity: 1;
    transform: rotateY(0) scale(1);
  }
}
.anim-flip {
  animation: flipIn 0.55s cubic-bezier(0.34, 1.3, 0.64, 1) both;
}

.result-card {
  position: relative;
  z-index: 2;
}

/* 稀有度光效：卡后放射光 */
.reveal-glow {
  position: absolute;
  top: 40rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  filter: blur(30rpx);
  animation: glowPulse 1.6s ease-in-out infinite;
  z-index: 1;
}
.glow-common {
  background: radial-gradient(circle, rgba(255, 255, 255, 0.22), transparent 65%);
}
.glow-rare {
  background: radial-gradient(circle, rgba(124, 140, 255, 0.35), transparent 65%);
}
.glow-legend {
  background: radial-gradient(circle, rgba(255, 213, 0, 0.4), transparent 65%);
}

.result-meta {
  margin-top: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}
.result-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.result-meta .rarity-tag {
  margin-top: 16rpx;
}
.result-line {
  margin-top: 26rpx;
  color: #b8bdc7;
  font-size: 26rpx;
}
.result-count {
  margin-top: 12rpx;
  color: #8a8f99;
  font-size: 22rpx;
}

.ok-btn {
  margin-top: 64rpx;
  width: 60%;
  height: 88rpx;
  line-height: 88rpx;
  z-index: 2;
}
