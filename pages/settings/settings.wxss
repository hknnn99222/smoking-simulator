.container {
  align-items: stretch;
  gap: 28rpx;
  padding-bottom: 60rpx;
}

.card-head {
  font-size: 26rpx;
  color: #d8dce2;
  margin-bottom: 10rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #262a32;
}
.row:last-child {
  border-bottom: none;
}
.row-main {
  display: flex;
  flex-direction: column;
  margin-right: 20rpx;
}
.row-title {
  font-size: 28rpx;
  color: #e6e6e6;
}
.row-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

.price-input {
  display: flex;
  align-items: center;
  background: #262a32;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
}
.price-input .yen {
  color: #c8a063;
  margin-right: 8rpx;
}
.price-input input {
  width: 110rpx;
  text-align: right;
  color: #e6e6e6;
  font-size: 28rpx;
}

.picker-val {
  color: #c8a063;
  font-size: 28rpx;
}

.btn-danger {
  background: transparent;
  color: #d05a5a;
  font-size: 28rpx;
  border: 1rpx solid rgba(208, 90, 90, 0.4);
  border-radius: 48rpx;
  height: 84rpx;
  line-height: 84rpx;
}
.btn-danger::after {
  border: none;
}

.about {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6f7580;
  line-height: 1.6;
}
