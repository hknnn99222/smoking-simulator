.container {
  justify-content: space-between;
  padding-bottom: 60rpx;
}

/* 数据三连 */
.stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
  background: #1e2128;
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat .v {
  font-size: 40rpx;
  font-weight: 700;
  color: #c8a063;
}
.stat .k {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8f99;
}
.divider {
  width: 1rpx;
  height: 52rpx;
  background: #2c3038;
}

/* 烟盒英雄区 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.skin-meta {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.skin-name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.change-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

/* 连续天数 */
.streak {
  font-size: 26rpx;
  color: #b8bdc7;
}
.streak-num {
  color: #e8b64c;
  font-weight: 700;
  font-size: 30rpx;
}

/* 里程碑 */
.ms {
  width: 100%;
  box-sizing: border-box;
  background: #1e2128;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
}
.ms-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.ms-title {
  font-size: 26rpx;
  color: #d8dce2;
}
.ms-desc {
  font-size: 22rpx;
  color: #8a8f99;
}
.ms-bar {
  width: 100%;
  height: 12rpx;
  border-radius: 6rpx;
  background: #2c3038;
  overflow: hidden;
}
.ms-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #6fbf8f, #8fd8b0);
  transition: width 0.4s ease;
}

/* 点烟 CTA */
.cta {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ticket-tip {
  margin-bottom: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(200, 160, 99, 0.14);
  border: 1rpx solid rgba(200, 160, 99, 0.4);
  color: #e8cf9a;
  font-size: 24rpx;
}
.btn-light {
  width: 80%;
  height: 96rpx;
  line-height: 96rpx;
}
.hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8a8f99;
  letter-spacing: 4rpx;
}
